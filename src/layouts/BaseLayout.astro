---
import sourceSansLatin400 from '../assets/fonts/generated/source-sans-3-latin-400-normal.woff2?url';
import loraLatin400 from '../assets/fonts/generated/lora-latin-400-normal.woff2?url';
import loraLatin600 from '../assets/fonts/generated/lora-latin-600-normal.woff2?url';
import '../styles/fonts.generated.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LocaleRouter from '../components/LocaleRouter.astro';
import { getDictionary } from '../i18n';
import type { NavKey } from '../i18n/types';
import type { Locale } from '../lib/content';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  active?: NavKey | undefined;
  translationHref?: string | undefined;
  pageClass?: string;
}

const {
  locale,
  title,
  description,
  active,
  translationHref,
  pageClass = '',
} = Astro.props;
const copy = getDictionary(locale);
const pageTitle = title ? `${title} — ${copy.home.name}` : copy.meta.title;
const pageDescription = description ?? copy.meta.description;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const translationUrl = translationHref
  ? new URL(translationHref, Astro.site ?? Astro.url.origin)
  : undefined;
const htmlLang = locale === 'zh' ? 'zh-Hans' : 'en';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <LocaleRouter locale={locale} translationHref={translationHref} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7f4ed" />
    <meta name="description" content={pageDescription} />
    <link rel="preload" href={loraLatin400} as="font" type="font/woff2" crossorigin="anonymous" />
    {active === 'home' && (
      <link rel="preload" href={loraLatin600} as="font" type="font/woff2" crossorigin="anonymous" />
    )}
    <link rel="preload" href={sourceSansLatin400} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={htmlLang} href={canonical} />
    {translationUrl && (
      <link
        rel="alternate"
        hreflang={locale === 'zh' ? 'en' : 'zh-Hans'}
        href={translationUrl}
      />
    )}
    <title>{pageTitle}</title>
  </head>
  <body class:list={[`locale-${locale}`, pageClass]}>
    <a class="skip-link" href="#main-content">
      {locale === 'zh' ? '跳到主要内容' : 'Skip to content'}
    </a>
    <div class="site-shell">
      <Header
        locale={locale}
        active={active}
        translationHref={translationHref}
      />
      <main id="main-content">
        <slot />
      </main>
      <Footer locale={locale} />
    </div>
  </body>
</html>
